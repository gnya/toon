#include "group_id.h"
#include "shadow.h"

#define MAX_LOOP 50
#define TRACE_EPS 1.0e-5

/*
 * This function wraps `trace(pos, dir, ...)` for tracing.
 */
int trace_ray(point pos, vector dir, int finite, float len) {
    if (finite) {
        return trace(pos, dir, "maxdist", max(0.0, len));
    } else {
        return trace(pos, dir);
    }
}

/*
 * This function checks whether lights from the direction of
 * a given light source reaches the point of current interest.
 */
int shadow(vector L, float ray_length, float cutoff, float eps) {
    int this_group = 0;
    int this_props = 0;  // Unused.
    int this_backfacing = dot(Ng, L) < 0.0;

    get_this_shadow_group(this_group, this_props);

    int count = 0;

    point pos = P + ray_offset(L, cutoff);
    int finite = ray_length >= 0.0;
    float len = ray_length;
    point last_pos = pos;

    if (this_backfacing) {
        pos -= L * eps;
    } else {
        pos += L * eps;
    }

    int hit_group = 0;
    int hit_props = 0;

    for (; count < MAX_LOOP && trace_ray(pos, L, finite, len); count++) {
        get_hit_shadow_group(hit_group, hit_props);

        if (this_group == 0 || this_group != hit_group) {
            if (hit_props == 0) {
                return 1;
            } else if (hit_props == 1 && !this_backfacing) {
                return 1;
            }
        }

        getmessage("trace", "P", pos);
        len -= distance(pos, last_pos);
        last_pos = pos;
        pos += L * eps;
    }

    if (count == MAX_LOOP) {
        warning("the max loop has been reached.");
    }

    return 0;
}

shader material(
    vector Light = vector(0.0, 0.0, 0.0)
    [[ string widget = "null" ]],
    float RayLength = 0.0
    [[ string widget = "null" ]],
    vector Normal = N
    [[ string widget = "null" ]],
    float Cutoff = 0.1,
    float Reflectance = 0.5,
    float Exponent = 10.0,

    color Color = color(0.0),
    float DiffuseThreshold = 0.1,
    float SpecularThreshold = 0.1,

    output color Diffuse = color(0.0),
    output color Specular = color(0.0)
) {
    float diffuse_value = max(0.0, dot(Light, Normal));
    float specular_value = 0.0;

    if (Reflectance > 0.0) {
        vector R = reflect(normalize(Light), Normal);
        specular_value = pow(max(0.0, dot(-I, R)), Exponent) * Reflectance;
    }

    if (diffuse_value > 0.0) {
        if (shadow(normalize(Light), RayLength, Cutoff, TRACE_EPS)) {
            diffuse_value = 0.0;
            specular_value = 0.0;
        }
    }

    if (diffuse_value >= DiffuseThreshold) {
        Diffuse = Color;
    }

    if (specular_value >= SpecularThreshold) {
        Specular = Color;
    }
}

/*
 * toon shader
 * author: gnya
 */

#include "node_math.h"

#define POINT_LIGHT         0
#define SUN_LIGHT           1
#define SPOT_LIGHT          2
#define AREA_LIGHT          3

shader light(
    int Type = 0,

    vector Location = vector(0.0, 0.0, 0.0),
    point Rotation = point(0.0, 0.0, 0.0),
    float Energy = 1.0,

    float Distance = 1.0,
    float Size = M_PI_4,
    float Width = 1.0,
    float Height = 1.0,

    output vector Light = vector(0.0, 0.0, 0.0),
    output float RayLength = 0.0,
    output vector UV = vector(0.0, 0.0, 0.0)
) {
    matrix mat = transpose(euler_to_mat(Rotation));

    if (Type == POINT_LIGHT) {
        // inputs: Location, Rotation, Energy, Size
        vector direction = normalize(Location - P);
        vector incomming = transform(mat, direction);

        UV = -incomming;

        float falloff = distance(Location, P) / Distance;
        float strength = Energy / M_PI / exp2(falloff);

        Light = direction * strength;
        RayLength = distance(Location, P);
    } else if (Type == SUN_LIGHT) {
        // inputs: Rotation, Energy
        vector z_axis = vector(mat[0][2], mat[1][2], mat[2][2]);

        float strength = Energy / M_PI;

        Light = z_axis * strength;
        RayLength = -1.0;
    } else if (Type == SPOT_LIGHT) {
        // inputs: Location, Rotation, Energy, Size
        vector direction = normalize(Location - P);
        vector incomming = transform(mat, direction);

        UV = -incomming / (abs(incomming[2]) * tan(Size / 2.0) * 2.0);

        if (abs(UV[0]) <= 0.5 && abs(UV[1]) <= 0.5 && UV[2] <= 0.0) {
            float strength = Energy / M_PI;

            Light = direction * strength;
            RayLength = distance(Location, P);
        }
    } else if (Type == AREA_LIGHT) {
        // inputs: Location, Rotation, Energy, Distance, Width, Height
        vector z_axis = vector(mat[0][2], mat[1][2], mat[2][2]);
        vector incomming = transform(mat, Location - P);

        UV = -incomming / vector(Width, Height, 1.0);

        if (abs(UV[0]) <= 0.5 && abs(UV[1]) <= 0.5 && UV[2] <= 0.0) {
            float falloff = -UV[2] / Distance;
            float strength = Energy / M_PI / exp2(falloff);

            Light = z_axis * strength;
            RayLength = -UV[2];
        }
    }
}
